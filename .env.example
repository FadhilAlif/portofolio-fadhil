# Resend Email Configuration
RESEND_API_KEY=resend_api_key
CONTACT_EMAIL_TO=youremail@example.com

# Supabase Configuration (server-only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Upstash Redis Configuration (required for rate limiting & chat quotas)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Gemini AI API KEY Configuration
GEMINI_API_KEY=your_gemini_api_key

# Clarity Analytics by Microsoft Configuration
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id
